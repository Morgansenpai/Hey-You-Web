rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /partnerInvites/{inviteCode} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.senderUid == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.senderUid == request.auth.uid ||
        request.resource.data.recipientUid == request.auth.uid
      );
      allow delete: if request.auth != null && resource.data.senderUid == request.auth.uid;
    }
  }
}
